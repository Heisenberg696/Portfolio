---
import { siteConfig } from "../config";
import SectionHeader from "./SectionHeader.astro";

const education = siteConfig.education[0];
---

<section id="about" class="mx-auto w-full max-w-[720px] border-t border-line px-5 py-8">
  <SectionHeader title="About" />

  <div class="space-y-4">
    <p>
      I'm a full-stack software engineer with 2+ years of experience building production web systems with React, Next.js, Node.js/Express, Django REST and MongoDB/PostgreSQL.
    </p>
    <p>
      I design RESTful APIs and third-party integrations (Paystack, Namecheap, WHM/cPanel, Firebase), secure payment and webhook flows, and deploy to Linux servers with Docker, Nginx and CI/CD.
    </p>
    <p>
      I build across the stack, from React and Next.js interfaces to the APIs, databases and Linux servers behind them, and I focus on clean, reliable code that keeps systems running smoothly.
    </p>
  </div>

  {education && (
    <p class="mt-6 text-muted">
      Education: {education.degree}, {education.school} ({education.dateRange})
    </p>
  )}
</section>
