---
import { siteConfig } from "../config";
import SectionHeader from "./SectionHeader.astro";

const education = siteConfig.education[0];
const coreStack = ["Node.js", "Express", "MongoDB", "React", "TypeScript"];
---

<section id="about" class="mx-auto w-full max-w-[720px] border-t border-line px-5 py-8">
  <SectionHeader title="About" />

  <div class="space-y-4">
    <p>
      I'm a back-end-focused full-stack software engineer with 2+ years of experience building production web systems using Node.js/Express, Django REST and MongoDB/PostgreSQL.
    </p>
    <p>
      I design RESTful APIs and third-party integrations (Paystack, Namecheap, WHM/cPanel, Firebase), secure payment and webhook flows, and deploy to Linux servers with Docker, Nginx and CI/CD.
    </p>
    <p>
      I'm comfortable on the front end with JavaScript, HTML/CSS and React when needed, and I focus on clean, reliable code that keeps systems running smoothly.
    </p>
  </div>

  <div class="mt-8">
    <p class="font-semibold text-ink">Core stack</p>
    <div class="mt-3 flex flex-wrap gap-2">
      {coreStack.map((tech) => <span class="chip">{tech}</span>)}
    </div>
  </div>

  {education && (
    <p class="mt-6 text-muted">
      Education: {education.degree}, {education.school} ({education.dateRange})
    </p>
  )}
</section>
