---
import { siteConfig } from "../config";
import SectionHeader from "./SectionHeader.astro";
---

<section id="contact" class="mx-auto w-full max-w-[720px] border-t border-line px-5 py-8">
  <SectionHeader title="Contact" />

  <div class="flex flex-wrap gap-x-4 gap-y-1 text-small">
    {siteConfig.social.email && (
      <a
        class="link-plain"
        data-email-link
        data-email={siteConfig.social.email}
        href={`mailto:${siteConfig.social.email}`}
      >{siteConfig.social.email}</a>
    )}
    {siteConfig.social.linkedin && (
      <a class="link-plain" href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
    )}
    {siteConfig.social.github && (
      <a class="link-plain" href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
    )}
    <a class="link-plain" href={siteConfig.resumeUrl} target="_blank" rel="noopener noreferrer">Resume (PDF)</a>
  </div>

  <span class="sr-only" aria-live="polite" data-email-status></span>
</section>

<script is:inline>
  (() => {
    const link = document.querySelector("[data-email-link]");
    const status = document.querySelector("[data-email-status]");
    if (!link || !status) return;

    const email = link.getAttribute("data-email");
    if (!email) return;

    const originalText = link.textContent.trim();
    let resetTimer;

    link.addEventListener("click", async (event) => {
      if (!navigator.clipboard || typeof navigator.clipboard.writeText !== "function") return;

      event.preventDefault();

      try {
        await navigator.clipboard.writeText(email);
        link.textContent = "Copied";
        status.textContent = "Email address copied to clipboard";

        clearTimeout(resetTimer);
        resetTimer = setTimeout(() => {
          link.textContent = originalText;
          status.textContent = "";
        }, 1500);
      } catch {
        window.location.href = `mailto:${email}`;
      }
    });
  })();
</script>
