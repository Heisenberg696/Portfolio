---
import { siteConfig } from "../config";
import SectionHeader from "./SectionHeader.astro";

const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{hasExperience && (
  <section id="experience" class="mx-auto w-full max-w-[720px] border-t border-line px-5 py-8">
    <SectionHeader title="Experience" />

    <ol class="ml-2 space-y-8 border-l border-line pl-8">
      {siteConfig.experience.map((exp) => {
        const isCurrent = exp.dateRange.trimEnd().endsWith("Present");
        const firstResponsibilities = exp.responsibilities.slice(0, 3);
        const moreResponsibilities = exp.responsibilities.slice(3);

        return (
          <li class="relative">
            <span
              class:list={[
                "absolute -left-9 top-2 h-2 w-2 rounded-full",
                isCurrent ? "bg-accent" : "bg-line",
              ]}
              aria-hidden="true"
            ></span>

            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:justify-between sm:gap-4">
              <h3 class="font-semibold">
                <span class="text-ink">{exp.title}</span><span class="text-muted"> · </span><span class="text-accent">{exp.company}</span>
              </h3>
              <span class="font-mono text-small text-muted sm:whitespace-nowrap sm:text-right">{exp.dateRange}</span>
            </div>

            {exp.type && <p class="text-small text-muted">{exp.type}</p>}

            {exp.description && <p>{exp.description}</p>}

            {firstResponsibilities.length > 0 && (
              <ul class="responsibility-list ml-5 list-disc space-y-2">
                {firstResponsibilities.map((responsibility) => (
                  <li>{responsibility}</li>
                ))}
              </ul>
            )}

            {moreResponsibilities.length > 0 && (
              <details class="mt-3">
                <summary class="show-more">
                  <span>Show more</span>
                  <svg class="show-more-chevron h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m9 6 6 6-6 6" />
                  </svg>
                </summary>
                <ul class="responsibility-list ml-5 mt-3 list-disc space-y-2">
                  {moreResponsibilities.map((responsibility) => (
                    <li>{responsibility}</li>
                  ))}
                </ul>
              </details>
            )}

            {exp.tech && exp.tech.length > 0 && (
              <div class="mt-4 flex flex-wrap gap-2">
                {exp.tech.map((tech) => <span class="chip">{tech}</span>)}
              </div>
            )}
          </li>
        );
      })}
    </ol>

    <p class="mt-8">
      <a href={siteConfig.resumeUrl} target="_blank" rel="noopener noreferrer">Download Full Resume</a>
    </p>
  </section>
)}
