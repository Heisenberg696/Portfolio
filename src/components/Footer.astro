---
import { execSync } from "node:child_process";

let gitHash = "dev";

try {
  gitHash = execSync("git rev-parse --short HEAD", {
    encoding: "utf8",
    stdio: ["ignore", "pipe", "ignore"],
  }).trim() || "dev";
} catch {
  gitHash = "dev";
}

const buildMonth = new Date().toLocaleString("en-US", { month: "short", year: "numeric" });
const buildStamp = `Built ${buildMonth} · ${gitHash}`;
---

<footer class="mx-auto w-full max-w-[720px] border-t border-line px-5 py-8 text-small text-muted">
  <p>© {new Date().getFullYear()} Swallieu Dawud. Built with Astro.</p>
  <p class="mt-1">Tip: press g then e, p, s, c or a to jump between sections. Cmd/Ctrl+K opens the command menu.</p>
  <p class="mt-1 font-mono text-small text-muted">{buildStamp}</p>
</footer>

<script is:inline>
  (() => {
    const targets = {
      e: "#experience",
      p: "#projects",
      s: "#skills",
      c: "#contact",
      a: "#about",
    };

    let armed = false;
    let timeout;

    document.addEventListener("keydown", (event) => {
      if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey || event.repeat) return;

      const target = event.target;
      if (
        target instanceof HTMLElement &&
        (target.isContentEditable || ["INPUT", "TEXTAREA", "SELECT"].includes(target.tagName))
      ) return;

      const key = event.key.toLowerCase();

      if (key === "g") {
        armed = true;
        clearTimeout(timeout);
        timeout = setTimeout(() => { armed = false; }, 1500);
        return;
      }

      if (!armed) return;

      armed = false;
      clearTimeout(timeout);

      const selector = targets[key];
      if (!selector) return;

      const section = document.querySelector(selector);
      section?.scrollIntoView({
        behavior: window.matchMedia("(prefers-reduced-motion: reduce)").matches ? "auto" : "smooth",
        block: "start",
      });
    });
  })();
</script>
