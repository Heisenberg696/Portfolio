---
import { siteConfig } from "../config";

const currentCompanies = siteConfig.experience
  .filter((exp) => exp.dateRange.trimEnd().endsWith("Present"))
  .map((exp) => exp.company);
---

<section id="hero" class="hero-section relative isolate mx-auto w-full max-w-[720px] px-5 py-8">
  <h1 class="sr-only">{siteConfig.name}, {siteConfig.title}</h1>

  <script is:inline>
    if (!window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      document.documentElement.classList.add("has-terminal-animation");
    }
  </script>

  <div
    data-terminal
    role="region"
    aria-label="Terminal showing identity, role, stack, current work and links"
    class="overflow-hidden rounded-lg border border-accent-line bg-surface shadow-[0_0_40px_var(--accent-glow)]"
  >
    <div class="flex items-center gap-2 border-b border-line px-6 py-3">
      <span class="h-2 w-2 rounded-full bg-muted" aria-hidden="true"></span>
      <span class="h-2 w-2 rounded-full bg-muted" aria-hidden="true"></span>
      <span class="h-2 w-2 rounded-full bg-muted" aria-hidden="true"></span>
      <span class="ml-2 font-mono text-small text-muted">~/portfolio</span>
    </div>

    <div class="min-w-0 p-6 font-mono text-small leading-relaxed break-words">
      <div data-line="command" class="text-accent">
        <span>$</span> <span data-typed>whoami</span><span data-cursor aria-hidden="true"></span>
      </div>
      <div data-line="output" class="text-ink">{siteConfig.name}</div>

      <div data-line="command" class="text-accent">
        <span>$</span> <span data-typed>cat role.txt</span><span data-cursor aria-hidden="true"></span>
      </div>
      <div data-line="output" class="text-ink">{siteConfig.tagline}</div>

      <div data-line="command" class="text-accent">
        <span>$</span> <span data-typed>ls stack/</span><span data-cursor aria-hidden="true"></span>
      </div>
      <div data-line="output" class="whitespace-pre-wrap text-ink">Node.js  Express  MongoDB  PostgreSQL  Django  React  Docker</div>

      <div data-line="command" class="text-accent">
        <span>$</span> <span data-typed>cat status.txt</span><span data-cursor aria-hidden="true"></span>
      </div>
      <div data-line="output" class="text-ink">Currently building at {currentCompanies.join(" and ")}</div>
      <div data-line="output" class="text-ink">Accra, Ghana</div>

      <div data-line="command" class="text-accent">
        <span>$</span> <span data-typed>open links</span><span data-cursor aria-hidden="true"></span>
      </div>
      <div data-line="output" class="flex flex-wrap gap-x-4 gap-y-1">
        <a class="link-plain" href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">GitHub</a>
        <a class="link-plain" href={siteConfig.social.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <a class="link-plain" href={`mailto:${siteConfig.social.email}`}>Email</a>
        <a class="link-plain" href={siteConfig.resumeUrl} target="_blank" rel="noopener noreferrer">Resume</a>
      </div>
    </div>
  </div>

  {siteConfig.available && (
    <p class="mt-4 font-mono text-small text-muted">
      <span class="availability-dot mr-2 inline-block h-2 w-2 rounded-full bg-available align-middle" aria-hidden="true"></span>
      Open to new opportunities
    </p>
  )}

  <script is:inline>
    (() => {
      if (!document.documentElement.classList.contains("has-terminal-animation")) return;

      const terminal = document.querySelector("[data-terminal]");
      if (!terminal) return;

      const lines = Array.from(terminal.querySelectorAll("[data-line]"));
      const wait = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

      (async () => {
        await wait(100);

        for (const line of lines) {
          line.classList.add("is-visible");

          if (line.getAttribute("data-line") === "command") {
            const typed = line.querySelector("[data-typed]");
            const text = typed.textContent || "";
            line.classList.add("is-typing");

            for (let count = 1; count <= text.length; count++) {
              typed.style.width = `${count}ch`;
              await wait(35);
            }

            typed.style.width = "auto";
            line.classList.remove("is-typing");
            await wait(180);
          } else {
            await wait(120);
          }
        }

        terminal.setAttribute("data-complete", "");
      })();
    })();
  </script>
</section>

<style is:global>
  .has-terminal-animation [data-line] {
    opacity: 0;
  }

  .has-terminal-animation [data-line].is-visible {
    opacity: 1;
  }

  .has-terminal-animation [data-typed] {
    display: inline-block;
    width: 0;
    overflow: hidden;
    white-space: pre;
    vertical-align: bottom;
  }

  [data-cursor] {
    display: none;
  }

  .has-terminal-animation [data-line].is-typing [data-cursor] {
    display: inline-block;
    width: 0.6em;
    height: 1em;
    margin-left: 0.1em;
    background-color: var(--accent);
    vertical-align: -0.15em;
    animation: terminal-cursor-blink 1s steps(2, start) infinite;
  }

  @keyframes terminal-cursor-blink {
    50% {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-line] {
      opacity: 1 !important;
    }

    [data-typed] {
      width: auto !important;
    }

    [data-cursor] {
      display: none !important;
    }
  }
</style>
