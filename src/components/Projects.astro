---
import { siteConfig } from "../config";
import SectionHeader from "./SectionHeader.astro";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;

const imageSizes: Record<string, { width: number; height: number }> = {
  "/images/voxta.webp": { width: 1200, height: 527 },
  "/images/handi.webp": { width: 1200, height: 592 },
  "/images/afrotales.webp": { width: 1024, height: 1024 },
};
---

{hasProjects && (
  <section id="projects" class="mx-auto w-full max-w-[720px] border-t border-line px-5 py-8">
    <SectionHeader title="Projects" />

    <ul
      class="relative left-1/2 mt-5 grid -translate-x-1/2 grid-cols-1 gap-5 lg:grid-cols-3"
      style="width: min(1120px, calc(100vw - 3rem));"
    >
      {siteConfig.projects.map((project) => {
        const size = imageSizes[project.image] ?? { width: 1200, height: 675 };
        const skills = project.skills ?? [];
        const visibleSkills = skills.slice(0, 5);
        const hiddenSkills = skills.slice(5);

        return (
        <li class="flex flex-col overflow-hidden rounded-[10px] border border-line bg-surface transition-colors duration-150 hover:border-accent-line-hover">
          <div class="flex items-center justify-between gap-3 border-b border-line bg-surface-alt px-3 py-2">
            <span class="min-w-0 truncate font-mono text-small text-muted">{project.name.toLowerCase()}/README.md</span>
            <span
              class:list={["h-1.5 w-1.5 shrink-0 rounded-full", project.link ? "bg-available" : "bg-muted"]}
              aria-hidden="true"
            ></span>
          </div>

          {project.image && (
            <img
              src={project.image}
              alt={`${project.name} preview`}
              width={size.width}
              height={size.height}
              loading="lazy"
              decoding="async"
              class="aspect-video w-full border-b border-line object-cover object-top"
            />
          )}

          <div class="flex flex-1 flex-col p-5">
            <div class="flex-1">
              <h3 class="font-semibold">
                {project.link ? (
                  <a href={project.link} target="_blank" rel="noopener noreferrer">{project.name}</a>
                ) : (
                  project.name
                )}
              </h3>

              {project.subtitle && <p class="text-muted">{project.subtitle}</p>}

              <p class="line-clamp-4">{project.description}</p>

              {skills.length > 0 && (
                <div class="mt-4 flex flex-wrap gap-2">
                  {visibleSkills.map((skill) => <span class="chip">{skill}</span>)}
                  {hiddenSkills.length > 0 && (
                    <span class="chip" title={hiddenSkills.join(", ")}>+{hiddenSkills.length}</span>
                  )}
                  <span class="sr-only">{skills.join(", ")}</span>
                </div>
              )}
            </div>

            <div class="mt-auto flex flex-wrap gap-x-4 gap-y-1 border-t border-line pt-4 text-small">
              {project.demoVideo && (
                <a class="link-plain" href={project.demoVideo} target="_blank" rel="noopener noreferrer">Demo</a>
              )}
              {project.link && (
                <a class="link-plain" href={project.link} target="_blank" rel="noopener noreferrer">Live</a>
              )}
              {project.github && (
                project.githubClickable === false ? (
                  <span class="text-muted">GitHub</span>
                ) : (
                  <a class="link-plain" href={project.github} target="_blank" rel="noopener noreferrer">GitHub</a>
                )
              )}
            </div>
          </div>
        </li>
        );
      })}
    </ul>

    <p class="mt-8">
      <a href={siteConfig.social.github} target="_blank" rel="noopener noreferrer">More on GitHub</a>
    </p>
  </section>
)}
