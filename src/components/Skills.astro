---
import { siteConfig } from "../config";
import SectionHeader from "./SectionHeader.astro";

const categories = Object.values(siteConfig.skillCategories);
---

<section id="skills" class="mx-auto w-full max-w-[720px] border-t border-line px-5 py-8">
  <SectionHeader title="Skills" />

  <div class="space-y-6">
    {categories.map((category) => (
      <div class="grid gap-2 sm:grid-cols-[160px_1fr] sm:gap-6">
        <p class="font-semibold text-ink">{category.title}</p>
        <div class="flex flex-wrap gap-2">
          {category.skills.map((skill) => <span class="chip">{skill}</span>)}
        </div>
      </div>
    ))}
  </div>
</section>
